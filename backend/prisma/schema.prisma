generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  CLIENTA
  CAJERO
  ADMIN
  ENCARGADO
  PROVEEDOR
  SUPERADMIN
}

enum Canal {
  online
  pos
}

enum EstadoVenta {
  cobrada
  anulada
  pendiente_pago
  devuelta
  devuelta_parcial
}

enum MedioPago {
  efectivo
  qr
  contra_entrega
  tarjeta
  transferencia
  mixto
}

enum EstadoReserva {
  pendiente
  preparada
  en_atencion
  completada
  cancelada
}

enum TipoMovimiento {
  venta
  reserva
  liberacion
  ajuste
  ingreso_proveedor
  transferencia_salida
  transferencia_entrada
  devolucion
}

enum EstadoPago {
  pendiente
  aprobado
  rechazado
  reembolsado
}

model Usuario {
  id            String              @id @default(uuid())
  email         String              @unique
  nombre        String              @default("")
  passwordHash  String              @map("password_hash")
  activo        Boolean             @default(true)
  mayorista     Boolean             @default(false)
  rol           Rol
  sucursalId    String?             @map("sucursal_id")
  sucursal      Sucursal?           @relation(fields: [sucursalId], references: [id])
  proveedorId   String?             @map("proveedor_id")
  proveedor     Proveedor?          @relation(fields: [proveedorId], references: [id])
  turnos        CajaTurno[]
  ventasClienta Venta[]             @relation("ClientaVentas")
  reportes      ReporteEjecucion[]
  reservas      Reserva[]
  opiniones     Opinion[]
  alertas       AlertaProducto[]
  direcciones   DireccionCliente[]
  favoritos     Favorito[]
  lealtad       CuentaLealtad?
  pedidos       Pedido[]
  notificaciones Notificacion[]
  empleado      Empleado?
  avatarUrl     String              @default("") @map("avatar_url")

  @@map("usuarios")
}

model Sucursal {
  id        String      @id @default(uuid())
  nombre    String
  ciudad    String
  almacenes Almacen[]
  turnos    CajaTurno[]
  usuarios  Usuario[]
  reservas  Reserva[]

  @@map("sucursales")
}

model Almacen {
  id          String                 @id @default(uuid())
  nombre      String
  sucursalId  String                 @map("sucursal_id")
  sucursal    Sucursal               @relation(fields: [sucursalId], references: [id])
  stocks      StockAlmacen[]
  ventas      Venta[]
  movimientos MovimientoInventario[]

  @@map("almacenes")
}

model Proveedor {
  id        String     @id @default(uuid())
  nombre    String
  contacto  String     @default("")
  productos Producto[]
  usuarios  Usuario[]

  @@map("proveedores")
}

model Temporada {
  id        String     @id @default(uuid())
  nombre    String     @unique
  productos Producto[]

  @@map("temporadas")
}

model Coleccion {
  id        String     @id @default(uuid())
  nombre    String     @unique
  productos Producto[]

  @@map("colecciones")
}

model Producto {
  id           String     @id @default(uuid())
  nombre       String
  descripcion  String     @default("")
  categoria    String
  ocasion      String
  precioBase      Decimal  @map("precio_base") @db.Decimal(12, 2)
  precioMayorista Decimal? @map("precio_mayorista") @db.Decimal(12, 2)
  minimoMayorista Int      @default(0) @map("minimo_mayorista")
  descuentoPct    Decimal  @default(0) @map("descuento_pct") @db.Decimal(5, 2)
  temporadaId  String?    @map("temporada_id")
  temporada    Temporada? @relation(fields: [temporadaId], references: [id])
  coleccionId  String?    @map("coleccion_id")
  coleccion    Coleccion? @relation(fields: [coleccionId], references: [id])
  proveedorId  String?    @map("proveedor_id")
  proveedor    Proveedor? @relation(fields: [proveedorId], references: [id])
  variantes    Variante[]
  opiniones    Opinion[]
  alertas      AlertaProducto[]
  favoritos    Favorito[]
  categorias   ProductoCategoria[]
  creadoEn     DateTime @default(now()) @map("creado_en")
  material     String   @default("")
  ajuste       String   @default("")
  composicion  String   @default("")
  cuidados     String   @default("")
  origen       String   @default("")
  modelo       String   @default("")
  popularidad  Int      @default(0)

  @@map("productos")
}

model Variante {
  id            String                 @id @default(uuid())
  productoId    String                 @map("producto_id")
  producto      Producto               @relation(fields: [productoId], references: [id])
  talla         String
  color         String
  sku           String                 @unique
  urlFoto       String                 @default("") @map("url_foto")
  urlOverlay    String                 @default("") @map("url_overlay")
  urlModelo     String                 @default("") @map("url_modelo")
  stocks        StockAlmacen[]
  lineas        LineaVenta[]
  lineasReserva LineaReserva[]
  movimientos   MovimientoInventario[]

  @@unique([productoId, talla, color])
  @@index([productoId])
  @@map("variantes")
}

model StockAlmacen {
  varianteId String   @map("variante_id")
  almacenId  String   @map("almacen_id")
  cantidad   Int
  reservado  Int      @default(0)
  variante   Variante @relation(fields: [varianteId], references: [id])
  almacen    Almacen  @relation(fields: [almacenId], references: [id])

  @@id([varianteId, almacenId])
  @@index([almacenId])
  @@map("stock_almacen")
}

model MovimientoInventario {
  id         String         @id @default(uuid())
  tipo       TipoMovimiento
  cantidad   Int
  nota       String         @default("")
  creadoEn   DateTime       @default(now()) @map("creado_en")
  varianteId String         @map("variante_id")
  variante   Variante       @relation(fields: [varianteId], references: [id])
  almacenId  String         @map("almacen_id")
  almacen    Almacen        @relation(fields: [almacenId], references: [id])
  ventaId    String?        @map("venta_id")
  venta      Venta?         @relation(fields: [ventaId], references: [id])
  reservaId  String?        @map("reserva_id")
  reserva    Reserva?       @relation(fields: [reservaId], references: [id])
  usuarioId  String?        @map("usuario_id")

  @@index([almacenId, creadoEn])
  @@map("movimientos_inventario")
}

model Reserva {
  id         String         @id @default(uuid())
  estado     EstadoReserva  @default(pendiente)
  horario    DateTime
  nota       String         @default("")
  creadaEn   DateTime       @default(now()) @map("creada_en")
  clientaId  String         @map("clienta_id")
  clienta    Usuario        @relation(fields: [clientaId], references: [id])
  sucursalId String         @map("sucursal_id")
  sucursal   Sucursal       @relation(fields: [sucursalId], references: [id])
  lineas     LineaReserva[]
  movimientos MovimientoInventario[]

  @@index([sucursalId, estado])
  @@map("reservas")
}

model LineaReserva {
  id         String   @id @default(uuid())
  reservaId  String   @map("reserva_id")
  reserva    Reserva  @relation(fields: [reservaId], references: [id])
  varianteId String   @map("variante_id")
  variante   Variante @relation(fields: [varianteId], references: [id])
  cantidad   Int

  @@map("lineas_reserva")
}

model CajaTurno {
  id             String    @id @default(uuid())
  sucursalId     String    @map("sucursal_id")
  sucursal       Sucursal  @relation(fields: [sucursalId], references: [id])
  cajeroId       String    @map("cajero_id")
  cajero         Usuario   @relation(fields: [cajeroId], references: [id])
  fondoInicial   Decimal   @map("fondo_inicial") @db.Decimal(12, 2)
  abiertoEn      DateTime  @default(now()) @map("abierto_en")
  cerradoEn      DateTime? @map("cerrado_en")
  totalSistema   Decimal   @default(0) @map("total_sistema") @db.Decimal(12, 2)
  totalDeclarado Decimal?  @map("total_declarado") @db.Decimal(12, 2)
  ventas         Venta[]

  @@map("caja_turnos")
}

model Venta {
  id          String                 @id @default(uuid())
  uuid        String                 @unique
  canal       Canal
  estado      EstadoVenta
  medioPago   MedioPago              @map("medio_pago")
  total       Decimal                @db.Decimal(12, 2)
  creadaEn    DateTime               @default(now()) @map("creada_en")
  almacenId   String                 @map("almacen_id")
  almacen     Almacen                @relation(fields: [almacenId], references: [id])
  cajaTurnoId String?                @map("caja_turno_id")
  cajaTurno   CajaTurno?             @relation(fields: [cajaTurnoId], references: [id])
  clientaId   String?                @map("clienta_id")
  clienta     Usuario?               @relation("ClientaVentas", fields: [clientaId], references: [id])
  lineas       LineaVenta[]
  pago         PagoSimulado?
  movimientos  MovimientoInventario[]
  pedido       Pedido?
  devoluciones Devolucion[]

  @@index([creadaEn])
  @@index([cajaTurnoId])
  @@index([clientaId])
  @@map("ventas")
}

model LineaVenta {
  id             String   @id @default(uuid())
  ventaId        String   @map("venta_id")
  venta          Venta    @relation(fields: [ventaId], references: [id])
  varianteId     String   @map("variante_id")
  variante       Variante @relation(fields: [varianteId], references: [id])
  cantidad         Int
  cantidadDevuelta Int      @default(0) @map("cantidad_devuelta")
  precioUnitario   Decimal  @map("precio_unitario") @db.Decimal(12, 2)

  @@map("lineas_venta")
}

model PagoSimulado {
  id          String     @id @default(uuid())
  ventaId     String     @unique @map("venta_id")
  venta       Venta      @relation(fields: [ventaId], references: [id])
  estado      EstadoPago @default(pendiente)
  referencia  String     @default("")
  actualizado DateTime   @default(now()) @map("actualizado_en")

  @@map("pagos_simulados")
}

model ReporteEjecucion {
  id       String   @id @default(uuid())
  pregunta String
  sql      String
  filas    Int
  creadaEn DateTime @default(now()) @map("creada_en")
  adminId  String   @map("admin_id")
  admin    Usuario  @relation(fields: [adminId], references: [id])

  @@map("reporte_ejecuciones")
}

model Categoria {
  id        String              @id @default(uuid())
  nombre    String              @unique
  activa    Boolean             @default(true)
  productos ProductoCategoria[]
  @@map("categorias")
}

model ProductoCategoria {
  productoId  String   @map("producto_id")
  categoriaId String   @map("categoria_id")
  producto    Producto @relation(fields: [productoId], references: [id])
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  @@id([productoId, categoriaId])
  @@map("productos_categorias")
}

model DireccionCliente {
  id        String  @id @default(uuid())
  etiqueta  String  @default("Casa")
  detalle   String
  ciudad    String
  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  @@index([usuarioId])
  @@map("direcciones_cliente")
}

model Favorito {
  id        String   @id @default(uuid())
  creadoEn  DateTime @default(now()) @map("creado_en")
  usuarioId String   @map("usuario_id")
  productoId String  @map("producto_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  producto  Producto @relation(fields: [productoId], references: [id])
  @@unique([usuarioId, productoId])
  @@map("favoritos")
}

model CuentaLealtad {
  id        String   @id @default(uuid())
  puntos    Int      @default(0)
  nivel     String   @default("inicial")
  usuarioId String   @unique @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  @@map("cuentas_lealtad")
}

model Cupon {
  id          String   @id @default(uuid())
  codigo      String   @unique
  porcentaje  Decimal  @db.Decimal(5, 2)
  activo      Boolean  @default(true)
  venceEn     DateTime? @map("vence_en")
  usoMaximo   Int?     @map("uso_maximo")
  usado       Int      @default(0)
  creadoEn    DateTime @default(now()) @map("creado_en")
  @@map("cupones")
}

model Pedido {
  id           String    @id @default(uuid())
  estado       String    @default("pendiente")
  total        Decimal   @db.Decimal(12, 2)
  direccion    String    @default("")
  seguimiento  String    @default("")
  creadoEn     DateTime  @default(now()) @map("creado_en")
  enviadoEn    DateTime? @map("enviado_en")
  usuarioId    String    @map("usuario_id")
  usuario      Usuario   @relation(fields: [usuarioId], references: [id])
  ventaId      String?   @unique @map("venta_id")
  venta        Venta?    @relation(fields: [ventaId], references: [id])
  @@index([usuarioId, creadoEn])
  @@index([estado])
  @@map("pedidos")
}

model Devolucion {
  id        String            @id @default(uuid())
  nota      String            @default("")
  creadaEn  DateTime          @default(now()) @map("creada_en")
  ventaId   String            @map("venta_id")
  venta     Venta             @relation(fields: [ventaId], references: [id])
  usuarioId String?           @map("usuario_id")
  lineas    DevolucionLinea[]

  @@index([ventaId])
  @@map("devoluciones")
}

model DevolucionLinea {
  id           String     @id @default(uuid())
  cantidad     Int
  devolucionId String     @map("devolucion_id")
  devolucion   Devolucion @relation(fields: [devolucionId], references: [id])
  lineaVentaId String     @map("linea_venta_id")

  @@map("devolucion_lineas")
}

model Promocion {
  id          String   @id @default(uuid())
  nombre      String
  porcentaje  Decimal  @db.Decimal(5, 2)
  activa      Boolean  @default(true)
  iniciaEn    DateTime @default(now()) @map("inicia_en")
  venceEn     DateTime? @map("vence_en")
  @@map("promociones")
}

model Empleado {
  id          String   @id @default(uuid())
  usuarioId   String   @unique @map("usuario_id")
  puesto      String
  contrato    String   @default("")
  salario     Decimal  @default(0) @db.Decimal(12, 2)
  ingresoEn   DateTime @default(now()) @map("ingreso_en")
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  turnos      TurnoEmpleado[]
  @@map("empleados")
}

model TurnoEmpleado {
  id         String   @id @default(uuid())
  empleadoId String   @map("empleado_id")
  inicio     DateTime
  fin        DateTime?
  estado     String   @default("programado")
  empleado   Empleado @relation(fields: [empleadoId], references: [id])
  @@index([empleadoId, inicio])
  @@map("turnos_empleado")
}

model EventoAnalitica {
  id        String   @id @default(uuid())
  tipo      String
  ruta      String   @default("")
  datos     Json
  creadoEn  DateTime @default(now()) @map("creado_en")
  usuarioId String?  @map("usuario_id")
  @@index([tipo, creadoEn])
  @@map("eventos_analitica")
}

model Dispositivo {
  id          String   @id
  nombre      String   @default("")
  activo      Boolean  @default(true)
  ultimoUso   DateTime @default(now()) @map("ultimo_uso")
  creadoEn    DateTime @default(now()) @map("creado_en")
  @@map("dispositivos")
}

model OperacionSync {
  id          String   @id @default(uuid())
  operationId String   @unique @map("operation_id")
  dispositivoId String @map("dispositivo_id")
  estado      String   @default("pending")
  payload     Json
  error       String   @default("")
  creadoEn    DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")
  @@index([dispositivoId, estado])
  @@map("operaciones_sync")
}

model TokenRevocado {
  hash      String   @id
  revocadoEn DateTime @default(now()) @map("revocado_en")
  expiraEn  DateTime? @map("expira_en")
  @@map("tokens_revocados")
}

model Auditoria {
  id        String   @id @default(uuid())
  accion    String
  recurso   String   @default("")
  detalle   String   @default("")
  creadoEn  DateTime @default(now()) @map("creado_en")
  usuarioId String?  @map("usuario_id")
  @@index([usuarioId, creadoEn])
  @@map("auditoria")
}

model Notificacion {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      String
  titulo    String
  cuerpo    String
  enlace    String   @default("")
  leida     Boolean  @default(false)
  creadaEn  DateTime @default(now()) @map("creada_en")

  @@index([usuarioId, leida, creadaEn])
  @@map("notificaciones")
}

model Opinion {
  id          String   @id @default(uuid())
  puntuacion  Int
  comentario  String   @default("")
  imagenUrl   String   @default("") @map("imagen_url")
  verificada  Boolean  @default(false)
  moderada    Boolean  @default(false)
  creadaEn    DateTime @default(now()) @map("creada_en")
  productoId  String   @map("producto_id")
  producto    Producto @relation(fields: [productoId], references: [id])
  usuarioId   String   @map("usuario_id")
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([productoId, usuarioId])
  @@index([productoId, moderada])
  @@map("opiniones")
}

model AlertaProducto {
  id          String   @id @default(uuid())
  tipo        String
  activa      Boolean  @default(true)
  creadaEn    DateTime @default(now()) @map("creada_en")
  productoId  String   @map("producto_id")
  producto    Producto @relation(fields: [productoId], references: [id])
  usuarioId   String   @map("usuario_id")
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([productoId, usuarioId, tipo])
  @@map("alertas_producto")
}
