DATABASE_URL="postgresql://usuario:password@localhost:5432/ensayar?schema=public"
PORT=3000
JWT_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="12h"

# Google Gemini (chatbot y reportes). Sin clave o ante fallos se usan reglas locales.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"

# Azure AI Services — FLUX try-on (UC03). Recurso kind=AIServices (no el OpenAI de chat).
# En Students, FLUX.1-Kontext-pro suele tener cuota 0; usamos FLUX.2-pro (multi-referencia).
AZURE_AI_ENDPOINT="https://TU-RECURSO-AI.cognitiveservices.azure.com/"
AZURE_AI_API_KEY=""
AZURE_FLUX_DEPLOYMENT="FLUX.2-pro"
AZURE_FLUX_API_VERSION="preview"

# Correo — Azure Communication Services (igual que BioFarm en nube)
# Local: pegá SMTP_PASS desde Key Vault `kv-bf-ibplhe` secreto `mail-password`
#   az keyvault secret show --vault-name kv-bf-ibplhe --name mail-password --query value -o tsv
# Sin SMTP_PASS el envío se SIMULA (queda notificación in-app).
SMTP_HOST=smtp.azurecomm.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=no-responder@diegodevbox.me
SMTP_PASS=
SMTP_FROM="EnsayAR <no-responder@diegodevbox.me>"
