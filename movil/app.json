{
  "expo": {
    "name": "EnsayAR",
    "slug": "ensayar-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "EnsayAR usa la cámara solo para el probador virtual. El video no se sube."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "EnsayAR usa la cámara solo para el probador virtual."
      }
    },
    "android": {
      "package": "bo.ensayar.vesta",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "permissions": [
        "CAMERA",
        "INTERNET"
      ]
    }
  }
}
